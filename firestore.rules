rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedUser() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function adminData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn()
        && (
          (request.auth.token.keys().hasAny(["admin"]) && request.auth.token.admin == true)
          || (request.auth.token.keys().hasAny(["isAdmin"]) && request.auth.token.isAdmin == true)
          || (request.auth.token.keys().hasAny(["role"]) && request.auth.token.role in ["admin", "Admin", "ADMIN"])
          || (adminData().keys().hasAny(["role"]) && adminData().role in ["admin", "Admin", "ADMIN"])
          || (adminData().keys().hasAny(["admin"]) && adminData().admin == true)
          || (adminData().keys().hasAny(["isAdmin"]) && adminData().isAdmin == true)
        );
    }

    function isOrganizer() {
      return signedIn()
        && (
          isAdmin()
          || (request.auth.token.keys().hasAny(["organizer"]) && request.auth.token.organizer == true)
          || (request.auth.token.keys().hasAny(["isOrganizer"]) && request.auth.token.isOrganizer == true)
          || (request.auth.token.keys().hasAny(["role"]) && request.auth.token.role in ["organizer", "organisator", "Organizer", "Organisator"])
          || (adminData().keys().hasAny(["role"]) && adminData().role in ["organizer", "organisator", "Organizer", "Organisator"])
        );
    }

    function isKaderAthlete() {
      return signedIn()
        && (
          (request.auth.token.keys().hasAny(["kader"]) && request.auth.token.kader == true)
          || (request.auth.token.keys().hasAny(["isKaderAthlete"]) && request.auth.token.isKaderAthlete == true)
          || (request.auth.token.keys().hasAny(["role"]) && request.auth.token.role in ["kader-sportler", "kadersportler", "kader"])
          || (adminData().keys().hasAny(["role"]) && adminData().role in ["kader-sportler", "kadersportler", "kader"])
          || (adminData().keys().hasAny(["kader"]) && adminData().kader == true)
          || (adminData().keys().hasAny(["isKaderAthlete"]) && adminData().isKaderAthlete == true)
        );
    }

    function validAccessLevel(level) {
      return level in ["everyone", "authenticated", "kader", "organizer", "locked"];
    }

    function eventData(eventId) {
      return get(/databases/$(database)/documents/timerEvents/$(eventId)).data;
    }

    function eventAllows(eventId, field) {
      let data = eventData(eventId);
      return isAdmin()
        || (
          data.keys().hasAny([field])
          && (
            data[field] == "everyone"
            || (data[field] == "authenticated" && verifiedUser())
            || (data[field] == "kader" && (isKaderAthlete() || isOrganizer()))
            || (data[field] == "organizer" && isOrganizer())
          )
        );
    }

    function ownerKeepsProtectedFieldsSafe() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return !changedKeys.hasAny([
        "role",
        "admin",
        "isAdmin",
        "organizer",
        "isOrganizer",
        "organizerSince",
        "organizerGrantedBy",
        "adminSince",
        "adminGrantedBy",
        "personLinkDecision"
      ])
      && ownerKeepsLinkFieldsSafe(changedKeys);
    }

    function hasStoredLinkId() {
      return resource.data.keys().hasAny(["linkedPersonId"])
        || resource.data.keys().hasAny(["personId"]);
    }

    function ownerKeepsLinkFieldsSafe(changedKeys) {
      return (!changedKeys.hasAny(["personLinked"])
        || request.resource.data.personLinked == false)
      && (!changedKeys.hasAny(["personId"])
        || !request.resource.data.keys().hasAny(["personId"]))
      && (!changedKeys.hasAny(["linkedPersonId"])
        || !request.resource.data.keys().hasAny(["linkedPersonId"]))
      && (!changedKeys.hasAny(["personLinkStatus"])
        || (
          request.resource.data.personLinkStatus in ["open", "requested", "rejected", "withdrawn"]
          && (request.resource.data.personLinkStatus != "requested" || !hasStoredLinkId())
        ))
      && ownerKeepsLinkRequestSafe(changedKeys)
      && ownerKeepsLinkIssueSafe(changedKeys);
    }

    function ownerKeepsLinkRequestSafe(changedKeys) {
      return !changedKeys.hasAny(["personLinkRequest"])
        || !request.resource.data.keys().hasAny(["personLinkRequest"])
        || (
          request.resource.data.personLinkRequest.keys().hasOnly([
            "firstName",
            "lastName",
            "gender",
            "birthDate",
            "dlrgBranch",
            "identityHint",
            "identityConfirmed",
            "identityConfirmedAt",
            "accountEmail",
            "accountName",
            "accountUid",
            "status",
            "requestedAt",
            "updatedAt",
            "withdrawnAt"
          ])
          && request.resource.data.personLinkRequest.keys().hasAny(["status"])
          && request.resource.data.personLinkRequest.status in ["requested", "rejected", "withdrawn"]
          && (!request.resource.data.personLinkRequest.keys().hasAny(["accountUid"])
            || request.resource.data.personLinkRequest.accountUid == request.auth.uid)
          && (!request.resource.data.personLinkRequest.keys().hasAny(["identityHint"])
            || (
              request.resource.data.personLinkRequest.identityHint is string
              && request.resource.data.personLinkRequest.identityHint.size() <= 200
            ))
          && (!request.resource.data.personLinkRequest.keys().hasAny(["gender"])
            || request.resource.data.personLinkRequest.gender in ["maennlich", "weiblich"])
          && (!request.resource.data.personLinkRequest.keys().hasAny(["identityConfirmed"])
            || request.resource.data.personLinkRequest.identityConfirmed == true)
          && (!request.resource.data.personLinkRequest.keys().hasAny(["identityConfirmedAt"])
            || request.resource.data.personLinkRequest.identityConfirmedAt is timestamp)
          && (request.resource.data.personLinkRequest.status != "requested" || !hasStoredLinkId())
        );
    }

    function ownerKeepsLinkIssueSafe(changedKeys) {
      return !changedKeys.hasAny(["personLinkIssue"])
        || !request.resource.data.keys().hasAny(["personLinkIssue"])
        || (
          hasStoredLinkId()
          && request.resource.data.personLinkIssue.keys().hasOnly([
            "status",
            "message",
            "accountEmail",
            "accountName",
            "accountUid",
            "reportedAt",
            "withdrawnAt",
            "updatedAt"
          ])
          && request.resource.data.personLinkIssue.keys().hasAny(["status"])
          && request.resource.data.personLinkIssue.status in ["reported", "withdrawn"]
        );
    }

    function ownerCreatesOnlySportlerAccount() {
      return (!("role" in request.resource.data) || request.resource.data.role == "sportler")
        && !request.resource.data.keys().hasAny([
          "admin",
          "isAdmin",
          "organizer",
          "isOrganizer",
          "organizerSince",
          "organizerGrantedBy",
          "adminSince",
          "adminGrantedBy"
        ]);
    }

    function adminKeepsAdminGrantSafe(uid) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return (!changedKeys.hasAny(["role"])
        || request.resource.data.role in ["sportler", "kader-sportler", "organisator", "organizer"])
        && (!changedKeys.hasAny(["admin"]) || request.resource.data.admin == false)
        && (!changedKeys.hasAny(["isAdmin"]) || request.resource.data.isAdmin == false)
        && (
          request.auth.uid != uid
          || !changedKeys.hasAny(["role", "admin", "isAdmin"])
        );
    }

    match /users/{uid} {
      allow create: if isOwner(uid) && ownerCreatesOnlySportlerAccount();
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow update: if (isAdmin() && adminKeepsAdminGrantSafe(uid))
        || (isOwner(uid) && ownerKeepsProtectedFieldsSafe());
      allow delete: if (isAdmin() && request.auth.uid != uid)
        || (isOwner(uid) && !isAdmin());
    }

    function validTimerEvent(data) {
      return data.keys().hasAll([
          "name",
          "poolLength",
          "enabledDisciplines",
          "timerAccess",
          "resultsAccess",
          "participantViewAccess",
          "participantEditAccess",
          "resultEditAccess",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasOnly([
          "name",
          "eventDate",
          "location",
          "poolLength",
          "customPoolLength",
          "enabledDisciplines",
          "resultUrl",
          "timerAccess",
          "resultsAccess",
          "participantViewAccess",
          "participantEditAccess",
          "resultEditAccess",
          "createdAt",
          "updatedAt"
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.location is string
        && data.location.size() <= 120
        && data.poolLength in ["25", "50", "custom"]
        && data.enabledDisciplines is list
        && data.enabledDisciplines.size() > 0
        && data.resultUrl is string
        && data.resultUrl.size() <= 500
        && validAccessLevel(data.timerAccess)
        && validAccessLevel(data.resultsAccess)
        && validAccessLevel(data.participantViewAccess)
        && validAccessLevel(data.participantEditAccess)
        && validAccessLevel(data.resultEditAccess);
    }

    function validParticipantData(data) {
      return data.keys().hasAll([
          "name",
          "birthYear",
          "ageGroup",
          "gender",
          "organization",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasOnly([
          "name",
          "birthYear",
          "ageGroup",
          "gender",
          "organization",
          "sourceDirectoryId",
          "createdAt",
          "updatedAt"
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.birthYear is int
        && data.birthYear >= 0
        && data.birthYear <= 99
        && data.ageGroup is string
        && data.ageGroup.size() > 0
        && data.ageGroup.size() <= 40
        && data.gender in ["male", "female"]
        && data.organization is string
        && data.organization.size() > 0
        && data.organization.size() <= 120;
    }

    function validParticipantCreate() {
      return validParticipantData(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validParticipantUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return validParticipantData(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && changedKeys.hasOnly([
          "name",
          "birthYear",
          "ageGroup",
          "gender",
          "organization",
          "updatedAt"
        ]);
    }

    function validResultPerson(data) {
      return data.keys().hasAll(["id", "name", "birthYear", "ageGroup", "gender", "organization"])
        && data.keys().hasOnly(["id", "name", "birthYear", "ageGroup", "gender", "organization"])
        && data.id is string
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.birthYear is int
        && data.birthYear >= 0
        && data.birthYear <= 99
        && data.ageGroup is string
        && data.ageGroup.size() <= 40
        && data.gender in ["male", "female"]
        && data.organization is string
        && data.organization.size() <= 120;
    }

    function validResultData(data) {
      return data.keys().hasAll([
          "discipline",
          "participantId",
          "participantIds",
          "participant",
          "teamMembers",
          "segments",
          "frequencies",
          "lapGroups",
          "totalCentiseconds",
          "officialCentiseconds",
          "submissionKey",
          "note",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasOnly([
          "discipline",
          "participantId",
          "participantIds",
          "participant",
          "teamMembers",
          "segments",
          "frequencies",
          "lapGroups",
          "totalCentiseconds",
          "officialCentiseconds",
          "submissionKey",
          "note",
          "createdAt",
          "updatedAt"
        ])
        && data.discipline in [
          "normal",
          "rescue50",
          "rescue100",
          "lifesaver100",
          "medley100",
          "superLifesaver200",
          "obstacle200",
          "manikinRelay4x25",
          "rescueTubeRelay4x50",
          "rescueRelay4x50",
          "obstacleRelay4x50",
          "mixedRelay4x50",
          "lineThrow"
        ]
        && data.participantId is string
        && data.participantIds is list
        && data.participantIds.size() > 0
        && data.participantIds.size() <= 4
        && data.participant is map
        && validResultPerson(data.participant)
        && data.teamMembers is list
        && data.teamMembers.size() <= 4
        && data.segments is list
        && data.segments.size() > 0
        && data.segments.size() <= 20
        && data.frequencies is list
        && data.frequencies.size() == data.segments.size()
        && data.lapGroups is list
        && data.lapGroups.size() == data.segments.size()
        && data.totalCentiseconds is int
        && data.totalCentiseconds > 0
        && (data.officialCentiseconds == null || data.officialCentiseconds is int)
        && (data.officialCentiseconds == null || data.officialCentiseconds > 0)
        && (data.submissionKey == null || data.submissionKey is string)
        && (data.submissionKey == null || data.submissionKey.size() <= 64)
        && data.note is string
        && data.note.size() <= 300;
    }

    function validResultCreate() {
      let data = request.resource.data;
      return validResultData(data)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validResultUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return validResultData(request.resource.data)
        && request.resource.data.discipline == resource.data.discipline
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.submissionKey == resource.data.submissionKey
        && request.resource.data.updatedAt == request.time
        && changedKeys.hasOnly([
          "participantId",
          "participantIds",
          "participant",
          "teamMembers",
          "segments",
          "frequencies",
          "lapGroups",
          "totalCentiseconds",
          "officialCentiseconds",
          "note",
          "createdPauseGeneration",
          "updatedAt"
        ]);
    }

    match /timerEvents/{eventId} {
      allow read: if true;
      allow create: if isOrganizer()
        && validTimerEvent(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOrganizer()
        && validTimerEvent(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOrganizer();

      match /participants/{participantId} {
        allow read: if eventAllows(eventId, "participantViewAccess")
          || eventAllows(eventId, "participantEditAccess")
          || eventAllows(eventId, "timerAccess")
          || eventAllows(eventId, "resultEditAccess");
        allow create: if eventAllows(eventId, "participantEditAccess")
          && validParticipantCreate();
        allow update: if eventAllows(eventId, "participantEditAccess")
          && validParticipantUpdate();
        allow delete: if eventAllows(eventId, "participantEditAccess");
      }

      match /results/{resultId} {
        allow get: if isAdmin()
          || eventAllows(eventId, "timerAccess")
          || eventAllows(eventId, "resultsAccess");
        allow list: if isAdmin()
          || eventAllows(eventId, "resultsAccess");
        allow create: if eventAllows(eventId, "timerAccess")
          && validResultCreate();
        allow update: if eventAllows(eventId, "resultsAccess")
          && eventAllows(eventId, "resultEditAccess")
          && validResultUpdate();
        allow delete: if eventAllows(eventId, "resultsAccess")
          && eventAllows(eventId, "resultEditAccess");
      }
    }

    match /timerParticipantDirectory/{candidateId} {
      allow read: if isOrganizer();
      allow write: if false;
    }
  }
}
