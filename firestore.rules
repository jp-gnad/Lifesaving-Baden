rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedUser() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function adminData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : {};
    }

    function storedRole(data) {
      let role = data.get("role", "");
      return role is string ? role.trim().lower() : "";
    }

    function adminAccount(data) {
      return storedRole(data) == "admin"
        || data.get("admin", false) == true || data.get("isAdmin", false) == true;
    }

    function isAdmin() {
      return signedIn() && (adminAccount(request.auth.token) || adminAccount(adminData()));
    }

    function accountRoleRank(data, claims) {
      let role = storedRole(data);
      return role == "admin" || data.get("admin", false) == true || data.get("isAdmin", false) == true ? 5
        : role in ["organizer", "organisator"]
          || (claims && (data.get("organizer", false) == true || data.get("isOrganizer", false) == true)) ? 4
        : role == "trainer" ? 3
        : role in ["athlete", "kader-sportler", "kadersportler", "kader"]
          || data.get("kader", false) == true || data.get("isKaderAthlete", false) == true ? 2 : 1;
    }

    function callerRoleRank() {
      let profile = adminData();
      let claimsRank = accountRoleRank(request.auth.token, true);
      let profileRank = accountRoleRank(profile, false);
      return profile.get("accountDeletionStartedAt", null) != null ? 1 : claimsRank > profileRank ? claimsRank : profileRank;
    }

    function isOrganizer() {
      return signedIn() && callerRoleRank() >= 4;
    }

    function validAccessLevel(level) {
      return level in ["everyone", "authenticated", "athlete", "trainer", "organizer", "locked", "kader"];
    }

    function eventData(eventId) {
      return get(/databases/$(database)/documents/timerEvents/$(eventId)).data;
    }

    function eventFieldAllows(data, field, rank) {
      return rank == 5
        || (
          data.keys().hasAny([field])
          && (
            data[field] == "everyone"
            || (data[field] == "authenticated" && verifiedUser())
            || (data[field] in ["athlete", "kader"] && rank >= 2)
            || (data[field] == "trainer" && rank >= 3)
            || (data[field] == "organizer" && rank >= 4)
          )
        );
    }

    function eventAllows(eventId, field) {
      return eventFieldAllows(eventData(eventId), field, signedIn() ? callerRoleRank() : 0);
    }

    function canEditEventResults(eventId) {
      let data = eventData(eventId);
      let rank = signedIn() ? callerRoleRank() : 0;
      return eventFieldAllows(data, "resultsAccess", rank)
        && eventFieldAllows(data, "resultEditAccess", rank);
    }

    function canWriteCustomDiscipline(eventId) {
      let data = eventData(eventId);
      let rank = signedIn() ? callerRoleRank() : 0;
      return eventFieldAllows(data, "timerAccess", rank)
        || (eventFieldAllows(data, "resultsAccess", rank) && eventFieldAllows(data, "resultEditAccess", rank));
    }

    function ownerKeepsProtectedFieldsSafe() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return !changedKeys.hasAny([
        "role",
        "admin",
        "isAdmin",
        "organizer",
        "isOrganizer",
        "organizerSince",
        "organizerGrantedBy",
        "adminSince",
        "adminGrantedBy",
        "kader",
        "isKaderAthlete",
        "personLinkDecision",
        "accountDeletionStartedAt"
      ])
      && (!changedKeys.hasAny(["personLink"]) || validOwnerUnlink(changedKeys))
      && ownerKeepsLinkFieldsSafe(changedKeys);
    }

    function validOwnerUnlink(changedKeys) {
      return resource.data.get("personLink", null) is map
        && !request.resource.data.keys().hasAny([
          "personLink", "linkedPersonId", "personId", "personLinked",
          "personLinkRequest", "personLinkIdentityHint", "personLinkIssue"
        ])
        && changedKeys.hasOnly([
          "personLink", "linkedPersonId", "personId", "personLinked", "personLinkStatus",
          "personLinkRequest", "personLinkIdentityHint", "personLinkIssue", "updatedAt"
        ])
        && request.resource.data.personLinkStatus == "open"
        && request.resource.data.updatedAt == request.time
        && linkReleased(resource.data.personLink);
    }

    function hasStoredLinkId() {
      return resource.data.get("personLink", null) is map;
    }

    function ownerKeepsLinkFieldsSafe(changedKeys) {
      return (!changedKeys.hasAny(["personLinked"])
        || request.resource.data.personLinked == false)
      && (!changedKeys.hasAny(["personId"])
        || !request.resource.data.keys().hasAny(["personId"]))
      && (!changedKeys.hasAny(["linkedPersonId"])
        || !request.resource.data.keys().hasAny(["linkedPersonId"]))
      && (!changedKeys.hasAny(["personLinkStatus"])
        || (
          request.resource.data.personLinkStatus in ["open", "requested", "rejected", "withdrawn"]
          && (request.resource.data.personLinkStatus != "requested" || !hasStoredLinkId())
        ))
      && ownerKeepsLinkRequestSafe(changedKeys)
      && ownerKeepsLinkIssueSafe(changedKeys);
    }

    function ownerKeepsLinkRequestSafe(changedKeys) {
      return !changedKeys.hasAny(["personLinkRequest"])
        || !request.resource.data.keys().hasAny(["personLinkRequest"])
        || (
          request.resource.data.personLinkRequest.keys().hasOnly([
            "firstName",
            "lastName",
            "gender",
            "birthDate",
            "dlrgBranch",
            "identityHint",
            "identityConfirmed",
            "identityConfirmedAt",
            "accountEmail",
            "accountName",
            "accountUid",
            "status",
            "requestedAt",
            "updatedAt",
            "withdrawnAt"
          ])
          && request.resource.data.personLinkRequest.keys().hasAny(["status"])
          && request.resource.data.personLinkRequest.status in ["requested", "rejected", "withdrawn"]
          && (!request.resource.data.personLinkRequest.keys().hasAny(["accountUid"])
            || request.resource.data.personLinkRequest.accountUid == request.auth.uid)
          && (!request.resource.data.personLinkRequest.keys().hasAny(["identityHint"])
            || (
              request.resource.data.personLinkRequest.identityHint is string
              && request.resource.data.personLinkRequest.identityHint.size() <= 200
            ))
          && (!request.resource.data.personLinkRequest.keys().hasAny(["gender"])
            || request.resource.data.personLinkRequest.gender in ["maennlich", "weiblich"])
          && (!request.resource.data.personLinkRequest.keys().hasAny(["identityConfirmed"])
            || request.resource.data.personLinkRequest.identityConfirmed == true)
          && (!request.resource.data.personLinkRequest.keys().hasAny(["identityConfirmedAt"])
            || request.resource.data.personLinkRequest.identityConfirmedAt is timestamp)
          && (request.resource.data.personLinkRequest.status != "requested" || !hasStoredLinkId())
        );
    }

    function ownerKeepsLinkIssueSafe(changedKeys) {
      return !changedKeys.hasAny(["personLinkIssue"])
        || !request.resource.data.keys().hasAny(["personLinkIssue"])
        || (
          hasStoredLinkId()
          && request.resource.data.personLinkIssue.keys().hasOnly([
            "status",
            "message",
            "accountEmail",
            "accountName",
            "accountUid",
            "reportedAt",
            "withdrawnAt",
            "updatedAt"
          ])
          && request.resource.data.personLinkIssue.keys().hasAny(["status"])
          && request.resource.data.personLinkIssue.status in ["reported", "withdrawn"]
        );
    }

    function ownerCreatesOnlyStandardAccount() {
      return (!("role" in request.resource.data) || request.resource.data.role in ["standard", "sportler"])
        && !request.resource.data.keys().hasAny([
          "admin",
          "isAdmin",
          "organizer",
          "isOrganizer",
          "organizerSince",
          "organizerGrantedBy",
          "adminSince",
          "adminGrantedBy",
          "kader",
          "isKaderAthlete"
        ])
        && !request.resource.data.keys().hasAny(["personLink", "linkedPersonId", "personId", "personLinked", "personLinkDecision"])
        && request.resource.data.get("personLinkStatus", "open") != "linked";
    }

    function adminKeepsAdminGrantSafe(uid) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return (!changedKeys.hasAny(["role"])
        || request.resource.data.role in ["standard", "athlete", "trainer", "organizer"])
        && (!changedKeys.hasAny(["admin"]) || request.resource.data.admin == false)
        && (!changedKeys.hasAny(["isAdmin"]) || request.resource.data.isAdmin == false)
        && (
          request.auth.uid != uid
          || !changedKeys.hasAny(["role", "admin", "isAdmin"])
        );
    }

    function adminUpdatesOnlyPersonLink() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "linkedPersonId",
        "personLink",
        "personId",
        "personLinkStatus",
        "personLinked",
        "personLinkRequest",
        "personLinkIdentityHint",
        "personLinkDecision",
        "personLinkIssue",
        "updatedAt"
      ]);
    }

    // A person reservation and the account must point to each other after every write.
    // The transaction's create on the person ID enforces uniqueness across admins.
    function validPersonSnapshot(person) {
      let source = get(/databases/$(database)/documents/timerParticipantDirectory/$(person.id)).data;
      return person.keys().hasAll(["id", "name", "birthYear", "gender", "organization"])
        && person.keys().hasOnly(["id", "name", "birthYear", "gender", "organization"])
        && person.id is string && person.id.matches('^[a-f0-9]{16}$')
        && person.name == source.name && person.birthYear == source.birthYear
        && person.gender == source.gender && person.organization == source.organization;
    }

    function linkReleased(person) {
      return person == null
        || !existsAfter(/databases/$(database)/documents/personAccountLinks/$(person.id));
    }

    function validAdminPersonLink(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let previous = resource.data.get("personLink", null);
      let next = request.resource.data.get("personLink", null);
      return !changed.hasAny(["personLink", "linkedPersonId", "personId", "personLinked"])
        || (
          !request.resource.data.keys().hasAny(["linkedPersonId", "personId", "personLinked"])
          && (next == null
            ? linkReleased(previous) && request.resource.data.personLinkStatus != "linked"
            : next is map && validPersonSnapshot(next)
              && getAfter(/databases/$(database)/documents/personAccountLinks/$(next.id)).data.uid == uid
              && request.resource.data.personLinkStatus == "linked"
              && (previous == null || previous.id == next.id || linkReleased(previous)))
        );
    }

    match /personAccountLinks/{personId} {
      allow read: if isAdmin();
      allow get: if verifiedTrainer();
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(["uid"])
        && request.resource.data.uid is string
        && exists(/databases/$(database)/documents/timerParticipantDirectory/$(personId))
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.personLink.id == personId;
      allow delete: if (isAdmin() || isOwner(resource.data.uid))
        && (!existsAfter(/databases/$(database)/documents/users/$(resource.data.uid))
          || (isAdmin() && getAfter(/databases/$(database)/documents/users/$(resource.data.uid)).data.get("personLink", {}).get("id", "") != personId)
          || (isOwner(resource.data.uid) && getAfter(/databases/$(database)/documents/users/$(resource.data.uid)).data.get("personLink", null) == null));
    }

    match /users/{uid} {
      allow create: if isOwner(uid) && !adminAccount(request.auth.token) && ownerCreatesOnlyStandardAccount();
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow update: if resource.data.get("accountDeletionStartedAt", null) == null
        && request.resource.data.get("accountDeletionStartedAt", null) == null
        && clubRoleChangeSafe(uid) && ((isOwner(uid) && ownerKeepsProtectedFieldsSafe())
        || (isAdmin() && validAdminPersonLink(uid) && (adminAccount(resource.data)
          ? adminUpdatesOnlyPersonLink() : adminKeepsAdminGrantSafe(uid))));
      allow update: if verifiedUser() && isOwner(uid) && !isAdmin()
        && !adminAccount(resource.data) && resource.data.get("accountDeletionStartedAt", null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["accountDeletionStartedAt", "updatedAt"])
        && request.resource.data.accountDeletionStartedAt == request.time && request.resource.data.updatedAt == request.time;
      allow delete: if !adminAccount(resource.data)
        && ((isAdmin() && request.auth.uid != uid) || (isOwner(uid) && !isAdmin()))
        && linkReleased(resource.data.get("personLink", null)) && noClubResponsibilities(uid);
    }

    function validTimerEvent(data) {
      return data.keys().hasAll([
          "name",
          "poolLength",
          "enabledDisciplines",
          "timerAccess",
          "resultsAccess",
          "participantViewAccess",
          "participantEditAccess",
          "resultEditAccess",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasOnly([
          "name",
          "eventDate",
          "location",
          "poolLength",
          "customPoolLength",
          "enabledDisciplines",
          "resultUrl",
          "timerAccess",
          "resultsAccess",
          "participantViewAccess",
          "participantEditAccess",
          "resultEditAccess",
          "participantIndexVersion",
          "createdAt",
          "updatedAt"
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.location is string
        && data.location.size() <= 120
        && data.poolLength in ["25", "50", "custom"]
        && data.enabledDisciplines is list
        && data.enabledDisciplines.size() > 0
        && data.resultUrl is string
        && data.resultUrl.size() <= 500
        && validAccessLevel(data.timerAccess)
        && validAccessLevel(data.resultsAccess)
        && validAccessLevel(data.participantViewAccess)
        && validAccessLevel(data.participantEditAccess)
        && validAccessLevel(data.resultEditAccess);
    }

    function validParticipantData(data) {
      return data.keys().hasAll([
          "name",
          "birthYear",
          "ageGroup",
          "gender",
          "organization",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasOnly([
          "name",
          "birthYear",
          "ageGroup",
          "gender",
          "organization",
          "sourceDirectoryId",
          "createdAt",
          "updatedAt"
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.birthYear is int
        && data.birthYear >= 0
        && data.birthYear <= 99
        && data.ageGroup is string
        && data.ageGroup.size() > 0
        && data.ageGroup.size() <= 40
        && data.gender in ["male", "female"]
        && data.organization is string
        && data.organization.size() > 0
        && data.organization.size() <= 120;
    }

    // Canonical Latin decompositions mirror TimerParticipantStore.identity.
    function participantNameKey(name) {
      return name.lower()
        .replace("[àáâãäåāăąǎǟǡǻȁȃȧḁạảấầẩẫậắằẳẵặ]", "a")
        .replace("[ḃḅḇ]", "b")
        .replace("[çćĉċčḉ]", "c")
        .replace("[ďḋḍḏḑḓ]", "d")
        .replace("[èéêëēĕėęěȅȇȩḕḗḙḛḝẹẻẽếềểễệ]", "e")
        .replace("[ḟ]", "f")
        .replace("[ĝğġģǧǵḡ]", "g")
        .replace("[ĥȟḣḥḧḩḫẖ]", "h")
        .replace("[ìíîïĩīĭįǐȉȋḭḯỉị]", "i")
        .replace("[ĵǰ]", "j")
        .replace("[ķǩḱḳḵ]", "k")
        .replace("[ĺļľḷḹḻḽ]", "l")
        .replace("[ḿṁṃ]", "m")
        .replace("[ñńņňǹṅṇṉṋ]", "n")
        .replace("[òóôõöōŏőơǒǫǭȍȏȫȭȯȱṍṏṑṓọỏốồổỗộớờởỡợ]", "o")
        .replace("[ṕṗ]", "p")
        .replace("[ŕŗřȑȓṙṛṝṟ]", "r")
        .replace("[śŝşšșṡṣṥṧṩ]", "s")
        .replace("[ß]", "ss")
        .replace("[ţťțṫṭṯṱẗ]", "t")
        .replace("[ùúûüũūŭůűųưǔǖǘǚǜȕȗṳṵṷṹṻụủứừửữự]", "u")
        .replace("[ṽṿ]", "v")
        .replace("[ŵẁẃẅẇẉẘ]", "w")
        .replace("[ẋẍ]", "x")
        .replace("[ýÿŷȳẏẙỳỵỷỹ]", "y")
        .replace("[źżžẑẓẕ]", "z")
        .replace("[^a-z0-9]", "");
    }

    function participantIdentity(data) {
      return participantNameKey(data.name) + "|" + string(data.birthYear) + "|" + data.gender;
    }

    function participantIndexReady(eventId) {
      return eventData(eventId).get("participantIndexVersion", 0) == 1;
    }

    function identityIds(eventId, key) {
      let path = /databases/$(database)/documents/timerEvents/$(eventId)/participantIdentities/$(key);
      return exists(path) ? get(path).data.participantIds : [];
    }

    function identityAfterIds(eventId, key) {
      return getAfter(/databases/$(database)/documents/timerEvents/$(eventId)/participantIdentities/$(key)).data.participantIds;
    }

    function validIdentityWrite(eventId, key) {
      let data = request.resource.data;
      let id = data.changedParticipantId;
      let path = /databases/$(database)/documents/timerEvents/$(eventId)/participants/$(id);
      let was = exists(path) && participantIdentity(get(path).data) == key;
      let now = existsAfter(path) && participantIdentity(getAfter(path).data) == key;
      let previous = resource == null ? [] : resource.data.participantIds;
      let remaining = was ? previous.removeAll([id]) : previous;
      return (was || now)
        && data.keys().hasOnly(["participantIds", "changedParticipantId"])
        && data.participantIds is list && id is string && id.size() > 0 && id.size() <= 1500
        && data.participantIds.size() == data.participantIds.toSet().size()
        && data.participantIds.toSet() == (now ? remaining.toSet().union([id].toSet()) : remaining.toSet())
        && (!(now && !was) || previous.size() == 0);
    }

    function validParticipantCreate(eventId, id) {
      return validParticipantData(request.resource.data)
        && participantIndexReady(eventId)
        && identityIds(eventId, participantIdentity(request.resource.data)).size() == 0
        && identityAfterIds(eventId, participantIdentity(request.resource.data)) == [id]
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validParticipantUpdate(eventId, id) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let previousKey = participantIdentity(resource.data);
      let nextKey = participantIdentity(request.resource.data);
      return validParticipantData(request.resource.data)
        && participantIndexReady(eventId)
        && id in identityIds(eventId, previousKey)
        && id in identityAfterIds(eventId, nextKey)
        && (previousKey == nextKey || (identityIds(eventId, nextKey).size() == 0
          && identityAfterIds(eventId, nextKey) == [id]
          && !(id in identityAfterIds(eventId, previousKey))))
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && changedKeys.hasOnly([
          "name",
          "birthYear",
          "ageGroup",
          "gender",
          "organization",
          "updatedAt"
        ]);
    }

    function validResultPerson(data) {
      return data.keys().hasAll(["id", "name", "birthYear", "ageGroup", "gender", "organization"])
        && data.keys().hasOnly(["id", "name", "birthYear", "ageGroup", "gender", "organization"])
        && data.id is string
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.birthYear is int
        && data.birthYear >= 0
        && data.birthYear <= 99
        && data.ageGroup is string
        && data.ageGroup.size() <= 40
        && data.gender in ["male", "female"]
        && data.organization is string
        && data.organization.size() <= 120;
    }

    function validResultData(data) {
      return data.keys().hasAll([
          "discipline",
          "participantId",
          "participantIds",
          "participant",
          "teamMembers",
          "segments",
          "frequencies",
          "lapGroups",
          "totalCentiseconds",
          "officialCentiseconds",
          "submissionKey",
          "note",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasOnly([
          "discipline",
          "participantId",
          "participantIds",
          "participant",
          "teamMembers",
          "segments",
          "frequencies",
          "lapGroups",
          "totalCentiseconds",
          "officialCentiseconds",
          "submissionKey",
          "note",
          "customDisciplineId",
          "customDisciplineName",
          "customLapCount",
          "timekeeper",
          "createdAt",
          "updatedAt"
        ])
        && data.discipline in [
          "normal",
          "rescue50",
          "rescue100",
          "lifesaver100",
          "medley100",
          "superLifesaver200",
          "obstacle100",
          "obstacle200",
          "manikinRelay4x25",
          "rescueTubeRelay4x50",
          "rescueRelay4x50",
          "obstacleRelay4x50",
          "mixedRelay4x50",
          "lineThrow"
        ]
        && data.participantId is string
        && data.participantIds is list
        && data.participantIds.size() > 0
        && data.participantIds.size() <= 4
        && data.participant is map
        && validResultPerson(data.participant)
        && data.teamMembers is list
        && data.teamMembers.size() <= 4
        && data.segments is list
        && data.segments.size() > 0
        && data.segments.size() <= 20
        && data.frequencies is list
        && data.frequencies.size() == data.segments.size()
        && data.lapGroups is list
        && data.lapGroups.size() == data.segments.size()
        && data.totalCentiseconds is int
        && data.totalCentiseconds > 0
        && (data.officialCentiseconds == null || data.officialCentiseconds is int)
        && (data.officialCentiseconds == null || data.officialCentiseconds > 0)
        && (data.submissionKey == null || data.submissionKey is string)
        && (data.submissionKey == null || data.submissionKey.size() <= 64)
        && data.note is string
        && data.note.size() <= 300
        && data.get("customDisciplineId", "") is string
        && data.get("customDisciplineId", "").size() <= 1000
        && data.get("customDisciplineName", "") is string
        && data.get("customDisciplineName", "").size() <= 80
        && data.get("customLapCount", 0) is int
        && (data.discipline != "normal" || (data.participantIds.size() == 1 && data.teamMembers.size() == 0));
    }

    function validCustomResult(eventId, data) {
      let id = data.get("customDisciplineId", "");
      let name = data.get("customDisciplineName", "");
      let count = data.get("customLapCount", 0);
      let groups = data.lapGroups;
      let last = groups[groups.size() - 1];
      return id == "" ? name == "" && count == 0
        : data.discipline == "normal" && id.matches("^[A-Za-z0-9%._~-]+$")
          && name.trim().size() > 0 && count >= 1 && count <= 20
          && data.segments.size() <= count
          && last is map && last.laps is list && last.laps.size() > 0
          && last.laps[last.laps.size() - 1] == count
          && getAfter(/databases/$(database)/documents/timerEvents/$(eventId)/customDisciplines/$(id)).data.name == name
          && getAfter(/databases/$(database)/documents/timerEvents/$(eventId)/customDisciplines/$(id)).data.lapCount == count;
    }

    function obstacle100CoveredLaps(groups) {
      let last = groups[groups.size() - 1].laps;
      return last[last.size() - 1];
    }

    function validObstacle100Group(group, start) {
      return group is map && group.keys().hasOnly(["laps"])
        && group.laps is list
        && (group.laps == [start] || group.laps == [start, start + 1]
          || group.laps == [start, start + 1, start + 2]
          || group.laps == [start, start + 1, start + 2, start + 3])
        && start + group.laps.size() - 1 <= 4;
    }

    function validObstacle100Groups(groups) {
      return groups.size() > 0 && groups.size() <= 4
        && validObstacle100Group(groups[0], 1)
        && (groups.size() < 2 || validObstacle100Group(groups[1], 1 + groups[0].laps.size()))
        && (groups.size() < 3 || validObstacle100Group(groups[2], 1 + groups[0].laps.size() + groups[1].laps.size()))
        && (groups.size() < 4 || validObstacle100Group(groups[3], 1 + groups[0].laps.size() + groups[1].laps.size() + groups[2].laps.size()))
        && obstacle100CoveredLaps(groups) in [2, 4];
    }

    function obstacle100EventLaps(eventId) {
      let event = get(/databases/$(database)/documents/timerEvents/$(eventId)).data;
      return event.get("poolLength", "25") == "50"
        || (event.get("poolLength", "25") == "custom" && event.get("customPoolLength", 0) == 50) ? 2 : 4;
    }

    function validResultCreate(eventId) {
      let data = request.resource.data;
      return validResultData(data)
        && validTimekeeperCreate(data)
        && validCustomResult(eventId, data)
        && (data.discipline != "obstacle100"
          || (validObstacle100Groups(data.lapGroups) && obstacle100CoveredLaps(data.lapGroups) == obstacle100EventLaps(eventId)))
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validTimekeeperCreate(data) {
      return !("timekeeper" in data) || (data.timekeeper is map
        && data.timekeeper.keys().hasAll(["uid", "initials"])
        && data.timekeeper.keys().hasOnly(["uid", "initials"])
        && data.timekeeper.uid == (signedIn() ? request.auth.uid : "")
        && data.timekeeper.initials is string
        && data.timekeeper.initials.trim().size() > 0 && data.timekeeper.initials.size() <= 40
        && (signedIn() || data.timekeeper.initials == "Unbekannt"));
    }

    function validResultUpdate(eventId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return validResultData(request.resource.data)
        && validCustomResult(eventId, request.resource.data)
        && (request.resource.data.discipline != "obstacle100"
          || (validObstacle100Groups(request.resource.data.lapGroups)
            && obstacle100CoveredLaps(request.resource.data.lapGroups) == obstacle100CoveredLaps(resource.data.lapGroups)))
        && request.resource.data.discipline == resource.data.discipline
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.submissionKey == resource.data.submissionKey
        && request.resource.data.updatedAt == request.time
        && changedKeys.hasOnly([
          "participantId",
          "participantIds",
          "participant",
          "teamMembers",
          "segments",
          "frequencies",
          "lapGroups",
          "totalCentiseconds",
          "officialCentiseconds",
          "note",
          "createdPauseGeneration",
          "customDisciplineId",
          "customDisciplineName",
          "customLapCount",
          "updatedAt"
        ]);
    }

    function boundedTimerList() {
      return request.query.limit is int && request.query.limit > 0 && request.query.limit <= 50;
    }

    match /timerEvents/{eventId} {
      allow get: if true;
      allow list: if boundedTimerList();
      allow create: if isOrganizer()
        && validTimerEvent(request.resource.data)
        && request.resource.data.participantIndexVersion == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOrganizer()
        && (validTimerEvent(request.resource.data)
          || (resource.data.get("participantIndexVersion", 0) == 0 && request.resource.data.participantIndexVersion == 1
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["participantIndexVersion", "updatedAt"])))
        && request.resource.data.get("participantIndexVersion", 0) in [0, 1]
        && (resource.data.get("participantIndexVersion", 0) != 1 || request.resource.data.participantIndexVersion == 1)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOrganizer();

      match /customDisciplines/{definitionId} {
        allow get: if isOrganizer() || eventAllows(eventId, "timerAccess") || eventAllows(eventId, "resultsAccess");
        allow list: if boundedTimerList()
          && (isOrganizer() || eventAllows(eventId, "timerAccess") || eventAllows(eventId, "resultsAccess"));
        allow create: if canWriteCustomDiscipline(eventId)
          && request.resource.data.keys().hasAll(["name", "lapCount", "resultId", "createdAt"])
          && request.resource.data.keys().hasOnly(["name", "lapCount", "resultId", "createdAt"])
          && request.resource.data.name is string && request.resource.data.name.trim().size() > 0 && request.resource.data.name.size() <= 80
          && request.resource.data.lapCount is int && request.resource.data.lapCount >= 1 && request.resource.data.lapCount <= 20
          && request.resource.data.resultId is string && request.resource.data.resultId.matches("^[^/]+$")
          && request.resource.data.resultId.size() <= 1500 && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/timerEvents/$(eventId)/results/$(request.resource.data.resultId)).data.discipline == "normal"
          && getAfter(/databases/$(database)/documents/timerEvents/$(eventId)/results/$(request.resource.data.resultId)).data.customDisciplineId == definitionId
          && getAfter(/databases/$(database)/documents/timerEvents/$(eventId)/results/$(request.resource.data.resultId)).data.customDisciplineName == request.resource.data.name
          && getAfter(/databases/$(database)/documents/timerEvents/$(eventId)/results/$(request.resource.data.resultId)).data.customLapCount == request.resource.data.lapCount;
        allow delete: if isOrganizer();
      }

      match /participantIdentities/{identityKey} {
        allow get: if eventAllows(eventId, "participantEditAccess");
        allow list: if isOrganizer() && eventAllows(eventId, "participantEditAccess");
        allow create, update: if eventAllows(eventId, "participantEditAccess")
          && ((!participantIndexReady(eventId) && isOrganizer()
              && request.resource.data.keys().hasOnly(["participantIds", "changedParticipantId"])
              && request.resource.data.participantIds is list)
            || (participantIndexReady(eventId) && validIdentityWrite(eventId, identityKey)));
        allow delete: if isOrganizer() && resource.data.participantIds.size() == 0;
      }

      match /participants/{participantId} {
        allow read: if eventAllows(eventId, "participantViewAccess")
          || eventAllows(eventId, "participantEditAccess")
          || eventAllows(eventId, "timerAccess")
          || eventAllows(eventId, "resultEditAccess");
        allow create: if eventAllows(eventId, "participantEditAccess")
          && validParticipantCreate(eventId, participantId);
        allow update: if eventAllows(eventId, "participantEditAccess")
          && validParticipantUpdate(eventId, participantId);
        allow delete: if eventAllows(eventId, "participantEditAccess") && participantIndexReady(eventId)
          && participantId in identityIds(eventId, participantIdentity(resource.data))
          && !(participantId in identityAfterIds(eventId, participantIdentity(resource.data)));
      }

      match /results/{resultId} {
        allow get: if isAdmin()
          || eventAllows(eventId, "timerAccess")
          || eventAllows(eventId, "resultsAccess");
        allow list: if boundedTimerList() && (isAdmin()
          || eventAllows(eventId, "resultsAccess"));
        allow create: if eventAllows(eventId, "timerAccess")
          && validResultCreate(eventId);
        allow update: if canEditEventResults(eventId)
          && validResultUpdate(eventId);
        allow delete: if canEditEventResults(eventId);
      }
    }

    function verifiedTrainer() {
      return verifiedUser() && callerRoleRank() >= 3;
    }

    function ownsWorktime(uid) {
      return isOwner(uid) && verifiedTrainer();
    }

    function validWorktimeTimes(data) {
      let startOffset = (data.day.toMillis() + data.startMinute * 60000 - data.startedAt.toMillis()) / 60000;
      let endOffset = (data.endDay.toMillis() + data.endMinute * 60000 - data.endedAt.toMillis()) / 60000;
      return data.day == data.day.date() && data.endDay == data.endDay.date()
        && data.endDay >= data.day
        && data.day >= timestamp.date(2000, 1, 1)
        && data.startMinute >= 0 && data.startMinute < 1440
        && data.endMinute >= 0 && data.endMinute < 1440
        && startOffset in [60, 120] && endOffset in [60, 120]
        && data.durationMinutes > 0
        && data.endedAt - data.startedAt == duration.value(data.durationMinutes, "m");
    }

    function validWorktime(data) {
      return data.keys().hasAll([
          "day", "endDay", "startMinute", "endMinute", "startedAt", "endedAt", "durationMinutes",
          "title", "description", "category", "organization", "organizationName", "createdAt", "updatedAt"
        ])
        && data.keys().hasOnly([
          "day", "endDay", "startMinute", "endMinute", "startedAt", "endedAt", "durationMinutes",
          "title", "description", "category", "organization", "organizationName", "createdAt", "updatedAt"
        ])
        && data.day is timestamp && data.endDay is timestamp && data.startedAt is timestamp && data.endedAt is timestamp
        && data.startMinute is int && data.endMinute is int && data.durationMinutes is int
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.title is string && data.title.trim().size() > 0 && data.title.size() <= 120
        && data.description is string && data.description.size() <= 2000
        && data.category in ["training", "competition", "organization", "athleteCare", "education", "publicRelations", "other"]
        && data.organization in [-1, 0, 1, 2]
        && data.organizationName is string && data.organizationName.size() <= 80
        && (data.organization == -1 ? data.organizationName == "" : data.organizationName.trim().size() > 0)
        && validWorktimeTimes(data);
    }

    function worktimeInterval(id, data) {
      return { "id": id, "start": data.startedAt, "end": data.endedAt };
    }

    function worktimeScheduleSaved(uid, id, data, present) {
      let path = /databases/$(database)/documents/users/$(uid)/worktimeSchedule/intervals;
      let lock = getAfter(path).data;
      return lock.entryId == id && lock.updatedAt == request.time
        && lock.entries.hasAny([worktimeInterval(id, data)]) == present;
    }

    function validWorktimeInsertion(entries, base, next, position) {
      return position >= 0 && position < entries.size()
        && entries.size() == base.size() + 1
        && entries[position] == next
        && entries.removeAll([next]) == base
        && (position == 0 || entries[position - 1].end <= next.start)
        && (position == entries.size() - 1 || next.end <= entries[position + 1].start);
    }

    function validWorktimeScheduleChange(uid, before) {
      let data = request.resource.data;
      let path = /databases/$(database)/documents/users/$(uid)/worktimeEntries/$(data.entryId);
      let had = exists(path);
      let has = existsAfter(path);
      let old = had ? get(path).data : {};
      let next = has ? getAfter(path).data : {};
      let base = had ? before.removeAll([worktimeInterval(data.entryId, old)]) : before;
      return (had || has)
        && (has
          ? validWorktimeInsertion(data.entries, base, worktimeInterval(data.entryId, next), data.position)
          : data.entries == base);
    }

    function validWorktimeSchedule(uid, before) {
      let data = request.resource.data;
      return data.keys().hasAll(["entries", "entryId", "position", "updatedAt"])
        && data.keys().hasOnly(["entries", "entryId", "position", "updatedAt"])
        && data.entries is list && data.entries.size() <= 5000
        && data.entryId is string && data.entryId.size() > 0 && data.entryId.size() <= 128
        && data.position is int && data.updatedAt == request.time
        && validWorktimeScheduleChange(uid, before);
    }

    // Previous day reservations stay private and read-only for compatibility.
    match /users/{uid}/worktimeDays/{dayId} {
      allow read: if ownsWorktime(uid);
      allow write: if false;
    }

    match /users/{uid}/worktimeSchedule/{scheduleId} {
      allow read: if ownsWorktime(uid);
      allow create: if ownsWorktime(uid) && scheduleId == "intervals"
        && validWorktimeSchedule(uid, []);
      allow update: if ownsWorktime(uid) && scheduleId == "intervals"
        && validWorktimeSchedule(uid, resource.data.entries);
      allow delete: if false;
    }

    match /users/{uid}/worktimeSettings/{settingsId} {
      allow read: if ownsWorktime(uid);
      allow create, update: if ownsWorktime(uid) && settingsId == "preferences"
        && request.resource.data.keys().hasOnly(["organizations"])
        && request.resource.data.organizations is list
        && request.resource.data.organizations.size() == 3
        && request.resource.data.organizations[0] is string && request.resource.data.organizations[0].size() <= 80
        && request.resource.data.organizations[1] is string && request.resource.data.organizations[1].size() <= 80
        && request.resource.data.organizations[2] is string && request.resource.data.organizations[2].size() <= 80;
      allow delete: if false;
    }

    // Deliberately no administrator override: detailed entries belong only to their owner.
    match /users/{uid}/worktimeEntries/{entryId} {
      allow read: if ownsWorktime(uid);
      allow delete: if ownsWorktime(uid) && worktimeScheduleSaved(uid, entryId, resource.data, false);
      allow create: if ownsWorktime(uid) && validWorktime(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && worktimeScheduleSaved(uid, entryId, request.resource.data, true);
      allow update: if ownsWorktime(uid) && validWorktime(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && worktimeScheduleSaved(uid, entryId, request.resource.data, true)
        && (request.resource.data.startedAt == resource.data.startedAt && request.resource.data.endedAt == resource.data.endedAt
          || worktimeScheduleSaved(uid, entryId, resource.data, false));
    }

    function startEligibilityDate(value) {
      // The app stores Berlin calendar dates as UTC midnight. In Berlin the
      // next UTC date can already have started up to two hours earlier.
      return value == null || (value is timestamp && value == value.date()
        && value >= timestamp.date(1900, 1, 1) && value <= request.time + duration.value(2, "h"));
    }

    function startEligibilityDates() {
      return ["swimSilver", "swimGold", "rescueBronze", "rescueSilver", "rescueGold", "combinedExercise", "healthDeclaration"];
    }

    // Retired private records are intentionally inaccessible. New records live
    // on the person membership inside each club.
    match /users/{uid}/startEligibility/{candidateId} {
      allow read, write: if false;
    }

    function noClubResponsibilities(uid) {
      let path = /databases/$(database)/documents/clubAccounts/$(uid);
      return !existsAfter(path) || getAfter(path).data.clubIds.size() == 0;
    }

    function deletingOwnAccount() {
      return verifiedUser() && adminData().get("accountDeletionStartedAt", null) != null;
    }

    function releasesOwnClub(id) {
      return deletingOwnAccount()
        && request.auth.uid in get(/databases/$(database)/documents/clubs/$(id)).data.managerIds;
    }

    function clubRoleChangeSafe(uid) {
      return accountRoleRank(request.resource.data, false) >= 3 || noClubResponsibilities(uid);
    }

    function managesClub(id) {
      let club = get(/databases/$(database)/documents/clubs/$(id)).data;
      return verifiedTrainer() && club.status == "active"
        && (isAdmin() || (club.get("responsibilityVersion", 1) == 2 && request.auth.uid in club.managerIds));
    }

    function validClubProfile(uid, data) {
      let account = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      let person = account.get("personLink", {});
      let role = accountRoleRank(account, false);
      let birthDate = account.get("birthDate", "");
      let birthYear = birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') ? int(birthDate.split('-')[0]) : null;
      return data.keys().hasOnly(["role", "personId", "name", "birthYear", "organization"])
        && data.role == (role == 5 ? "admin" : role == 4 ? "organizer" : role == 3 ? "trainer" : role == 2 ? "athlete" : "standard")
        && data.personId == person.get("id", "")
        && data.name == person.get("name", account.get("displayName", "").size() > 0 ? account.displayName : account.get("email", "Mitglied"))
        && data.organization == person.get("organization", account.get("dlrgBranch", ""))
        && (data.birthYear == null || (data.birthYear is int && data.birthYear >= 1900 && data.birthYear <= request.time.year()))
        && data.birthYear == person.get("birthYear", birthYear);
    }

    match /clubProfiles/{uid} {
      allow get: if isOwner(uid) || verifiedTrainer();
      allow list: if verifiedUser() && isAdmin();
      allow create, update: if verifiedUser() && (isAdmin() || isOwner(uid)) && validClubProfile(uid, request.resource.data);
      allow delete: if verifiedUser() && (isAdmin() || isOwner(uid))
        && (!existsAfter(/databases/$(database)/documents/users/$(uid))
          || accountRoleRank(getAfter(/databases/$(database)/documents/users/$(uid)).data, false) < 3);
    }

    function validClubIndex(uid, data, previous) {
      let id = data.changedClubId;
      let club = getAfter(/databases/$(database)/documents/clubs/$(id)).data;
      return data.keys().hasOnly(["clubIds", "changedClubId", "updatedAt"])
        && data.clubIds is list && data.clubIds.size() == data.clubIds.toSet().size()
        && data.clubIds.removeAll([id]) == previous.removeAll([id])
        && (id in data.clubIds) == (uid in club.managerIds)
        && club.changedManagerId == uid && club.updatedAt == request.time
        && data.updatedAt == request.time;
    }

    match /clubAccounts/{uid} {
      allow get: if verifiedUser() && (isOwner(uid) || isAdmin());
      allow create: if verifiedTrainer() && validClubIndex(uid, request.resource.data, []);
      allow update: if ((isOwner(uid) && deletingOwnAccount()) || verifiedTrainer())
        && validClubIndex(uid, request.resource.data, resource.data.clubIds);
    }

    function validClubBase(id, data) {
      return data.keys().hasOnly(["name", "managerIds", "changedManagerId", "status", "responsibilityVersion", "needsResponsible", "createdAt", "updatedAt"])
        && data.get("responsibilityVersion", 1) in [1, 2]
        && data.name is string && data.name.trim().size() > 0 && data.name.size() <= 120
        && id == data.name.trim().lower().toUtf8().toHexString().lower()
        && data.managerIds is list && data.managerIds.size() == data.managerIds.toSet().size()
        && data.status in ["active", "deleting"]
        && data.get("needsResponsible", false) == (data.status == "active" && data.managerIds.size() == 0)
        && data.updatedAt == request.time;
    }

    function validManagerChange(id, next, previous) {
      let uid = next.changedManagerId;
      let added = uid in next.managerIds;
      let account = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      let index = getAfter(/databases/$(database)/documents/clubAccounts/$(uid)).data;
      return next.managerIds.removeAll([uid]) == previous.removeAll([uid])
        && (added ? isAdmin() && accountRoleRank(account, false) >= 3 && account.get("accountDeletionStartedAt", null) == null
          && existsAfter(/databases/$(database)/documents/clubs/$(id)/people/$("account_" + uid))
          : (uid == request.auth.uid || isAdmin()))
        && (next.status != "active" || next.managerIds.size() > 0
          || (uid == request.auth.uid && deletingOwnAccount()))
        && (id in index.clubIds) == added && index.changedClubId == id && index.updatedAt == request.time;
    }

    function validOwnDeletionRelease(id, next, previous) {
      let uid = request.auth.uid;
      return deletingOwnAccount() && uid in previous.managerIds
        && next.diff(previous).affectedKeys().hasOnly(["managerIds", "needsResponsible", "changedManagerId", "updatedAt"])
        && next.managerIds == previous.managerIds.removeAll([uid])
        && next.needsResponsible == (next.status == "active" && next.managerIds.size() == 0)
        && next.changedManagerId == uid && next.updatedAt == request.time
        && ownDeletionReleaseIndexed(id);
    }

    function ownDeletionReleaseIndexed(id) {
      let index = getAfter(/databases/$(database)/documents/clubAccounts/$(request.auth.uid)).data;
      return !(id in index.clubIds) && index.changedClubId == id && index.updatedAt == request.time;
    }

    match /clubs/{id} {
      allow get: if releasesOwnClub(id);
      allow get, list: if verifiedTrainer() && (isAdmin() || (resource.data.status == "active"
        && resource.data.get("responsibilityVersion", 1) == 2 && request.auth.uid in resource.data.managerIds));
      allow create: if verifiedUser() && isAdmin() && validClubBase(id, request.resource.data)
        && request.resource.data.status == "active" && request.resource.data.managerIds.size() == 1
        && request.resource.data.responsibilityVersion == 2
        && request.resource.data.createdAt == request.time
        && validManagerChange(id, request.resource.data, []);
      allow update: if validOwnDeletionRelease(id, request.resource.data, resource.data);
      allow update: if validClubBase(id, request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.name == resource.data.name
        && (request.resource.data.get("responsibilityVersion", 1) == resource.data.get("responsibilityVersion", 1) || isAdmin())
        && ((managesClub(id) && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["managerIds", "needsResponsible", "changedManagerId", "updatedAt"])
          && validManagerChange(id, request.resource.data, resource.data.managerIds))
          || (verifiedUser() && isAdmin() && (request.resource.data.managerIds == resource.data.managerIds
            || validManagerChange(id, request.resource.data, resource.data.managerIds))));
      allow delete: if verifiedUser() && isAdmin() && resource.data.status == "deleting" && resource.data.managerIds.size() == 0;

      match /people/{personId} {
        allow get: if releasesOwnClub(id) && (personId == "account_" + request.auth.uid
          || personId == adminData().get("personLink", {}).get("id", ""));
        allow read: if managesClub(id) || (verifiedUser() && isAdmin());
        allow create: if ((releasesOwnClub(id) && personId == adminData().get("personLink", {}).get("id", "") && request.resource.data.accountUid == "")
          || managesClub(id) || (verifiedUser() && isAdmin()))
          && validClubPerson(id, personId, request.resource.data)
          && (request.resource.data.accountUid == "" || (isAdmin()
            && request.resource.data.accountUid in getAfter(/databases/$(database)/documents/clubs/$(id)).data.managerIds))
          && (request.resource.data.activeYears.size() == 0
            || (request.resource.data.accountUid != "" && request.resource.data.personId != ""
              && get(/databases/$(database)/documents/clubs/$(id)/people/$(request.resource.data.personId)).data.activeYears == request.resource.data.activeYears)
            || (request.resource.data.accountUid == "" && exists(/databases/$(database)/documents/personAccountLinks/$(personId))
              && get(/databases/$(database)/documents/clubs/$(id)/people/$("account_" + get(/databases/$(database)/documents/personAccountLinks/$(personId)).data.uid)).data.activeYears == request.resource.data.activeYears))
          && request.resource.data.createdAt == request.time;
        allow update: if ((releasesOwnClub(id)
            && personId == adminData().get("personLink", {}).get("id", "") && request.resource.data.accountUid == "") || managesClub(id))
          && validClubPerson(id, personId, request.resource.data)
          && request.resource.data.accountUid == resource.data.accountUid
          && (validClubActivity(request.resource.data.activeYears, resource.data.activeYears)
            || (request.resource.data.accountUid != "" && request.resource.data.personId != ""
              && !existsAfter(/databases/$(database)/documents/clubs/$(id)/people/$(request.resource.data.personId))
              && request.resource.data.activeYears.toSet() == resource.data.activeYears.toSet().union(get(/databases/$(database)/documents/clubs/$(id)/people/$(request.resource.data.personId)).data.activeYears.toSet()))
            || (releasesOwnClub(id) && personId == adminData().get("personLink", {}).get("id", "")
              && request.resource.data.activeYears.toSet() == resource.data.activeYears.toSet().union(get(/databases/$(database)/documents/clubs/$(id)/people/$("account_" + request.auth.uid)).data.activeYears.toSet())))
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if ((releasesOwnClub(id) && personId == "account_" + request.auth.uid)
          || managesClub(id) || (verifiedUser() && isAdmin()))
          && (resource.data.accountUid == "" || !(resource.data.accountUid in getAfter(/databases/$(database)/documents/clubs/$(id)).data.managerIds))
          && (resource.data.accountUid == "" || resource.data.accountUid == request.auth.uid || isAdmin()
            || !(resource.data.accountUid in get(/databases/$(database)/documents/clubs/$(id)).data.managerIds));
      }
    }

    function validClubPerson(id, personId, data) {
      let source = data.accountUid == ""
        ? (exists(/databases/$(database)/documents/timerParticipantDirectory/$(personId))
          ? get(/databases/$(database)/documents/timerParticipantDirectory/$(personId)).data : resource.data)
        : existsAfter(/databases/$(database)/documents/clubProfiles/$(data.accountUid))
          ? getAfter(/databases/$(database)/documents/clubProfiles/$(data.accountUid)).data : resource.data;
      return data.keys().hasOnly(["personId", "accountUid", "name", "birthYear", "organization", "activeYears", "createdAt", "updatedAt"].concat(startEligibilityDates()))
        && validClubDates(data)
        && data.name == source.name && data.birthYear == source.birthYear && data.organization == source.organization
        && (data.accountUid == "" ? data.personId == personId
          : personId == "account_" + data.accountUid && data.personId == source.personId)
        && data.activeYears is list && data.activeYears.size() == data.activeYears.toSet().size()
        && data.updatedAt == request.time;
    }

    function validClubActivity(next, previous) {
      let year = (request.time + duration.value(2, "h")).year();
      return next.removeAll([year, year + 1]) == previous.removeAll([year, year + 1]);
    }

    function validClubDates(data) {
      return startEligibilityDate(data.get("swimSilver", null)) && startEligibilityDate(data.get("swimGold", null))
        && startEligibilityDate(data.get("rescueBronze", null)) && startEligibilityDate(data.get("rescueSilver", null))
        && startEligibilityDate(data.get("rescueGold", null)) && startEligibilityDate(data.get("combinedExercise", null))
        && startEligibilityDate(data.get("healthDeclaration", null));
    }

    match /clubDirectory/{id} {
      allow read: if verifiedUser() && isAdmin();
      allow write: if false;
    }

    match /timerParticipantDirectory/{candidateId} {
      allow get: if deletingOwnAccount() && candidateId == adminData().get("personLink", {}).get("id", "");
      allow read: if isOrganizer();
      allow get: if verifiedTrainer();
      allow list: if verifiedTrainer() && request.query.limit is int && request.query.limit <= 10;
      allow write: if false;
    }
  }
}
